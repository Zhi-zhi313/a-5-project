<!-- 浮動小幫手：卡片（預設收起） -->
<div id="helpCard" class="collapse position-fixed end-4 bottom-3" style="z-index:1080;">
  <div class="card shadow-lg border-0" style="width: 280px;">
    <div class="card-body p-3">
      <h6 class="mb-2 fw-bold">你好～需要幫忙嗎？</h6>
      <p class="text-muted small mb-3">加入官方 LINE，安排專屬協助。</p>
      <div class="ratio ratio-1x1 mb-2">
        <img src="/assets/images/header/qrcode.png alt=" alt="加入 LINE QR Code" class="rounded">
      </div>
      <p class="text-center small text-muted mb-0">掃描後即可聯繫 LINE 客服</p>
    </div>
  </div>
</div>

<!-- 浮動按鈕 -->
<button id="helpFab"
        class="position-fixed "
        type="button"
        data-bs-toggle="collapse"
        data-bs-target="#helpCard"
        aria-controls="helpCard"
        aria-expanded="false"
        aria-label="開啟說明"><img src="/assets/images/header/help-btn.png" alt="">
</button>
